{
  "name": "campusplay-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "build": "echo 'No build step required for Node.js'",
    "seed": "node seed.js",
    "prod": "NODE_ENV=production node server.js",
    "test:deploy": "node test-deployment.js",
    "test": "NODE_ENV=test JWT_SECRET=test-secret TRUST_PROXY=1 AUTH_RATE_LIMIT_MAX=1000 node --test --test-concurrency=1 tests/"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
