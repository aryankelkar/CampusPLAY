# ========================================
# CampusPlay Backend Environment Variables
# ========================================

# Server Configuration
# -------------------
PORT=5000
NODE_ENV=development

# Database Configuration
# ---------------------
# Replace with your MongoDB connection string
# Use environment-specific MongoDB Atlas cluster
MONGO_URI=mongodb+srv://admin:aryan1847@campusplay-cluster.ukkoffp.mongodb.net/?appName=campusplay-cluster

# Security
# --------
# Generate a strong secret key (minimum 32 characters)
# Use: openssl rand -base64 32 or similar tool
# Example: dMD72NfVdPV1TSYSbCo2IfOvq452JaFQbyqW0fHtHpU=
JWT_SECRET=campusplay_secret_key

# CORS Configuration
# ------------------
# For development: http://localhost:3000
# For production: https://your-vercel-app.vercel.app
# Must match your Vercel frontend URL exactly
CORS_ORIGIN=https://campusplay-frontend.vercel.app/

# Admin Configuration
# --------------------
ADMIN_EMAIL=admin@vit.edu.in
ADMIN_PASSWORD=admin123

# ========================================
# Deployment Notes:
# - Render: Set these in Environment Variables section
# - Railway: Set in project settings
# - Change JWT_SECRET to a strong random value
# - Update CORS_ORIGIN to your Vercel frontend URL
# - Set NODE_ENV=production for deployment
# ========================================
