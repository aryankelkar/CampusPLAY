# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Replace with your MongoDB connection string
# Use environment-specific MongoDB Atlas cluster
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/campusplay?retryWrites=true&w=majority

# Security
# Generate a strong secret key (minimum 32 characters)
# Use: openssl rand -base64 32 or similar tool
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_change_this_in_production

# CORS Configuration
# For development: http://localhost:3000
# For production: https://your-vercel-app.vercel.app
CORS_ORIGIN=http://localhost:3000

# Admin Configuration
ADMIN_EMAIL=admin@vit.edu.in
ADMIN_PASSWORD=admin123
