# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/campusplay

# Required. Use a long random value, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (no trailing slash)
CORS_ORIGIN=http://localhost:3000

# Admin provisioning (used by `npm run seed` only).
# Public registration can never create an admin.
ADMIN_EMAIL=admin@campusplay.com
ADMIN_ROLL=ADMIN000
# Must satisfy the app password policy (8+ chars, upper, lower, digit).
# Leave empty in development to get a generated one-off password.
ADMIN_PASSWORD=

# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=10
